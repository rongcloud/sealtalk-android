<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/rc_auxiliary_background_1_color"
    android:orientation="vertical">

    <io.rong.imkit.usermanage.component.HeadComponent
        android:id="@+id/head_component"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:head_title_text="@string/seal_minor_mode_reset_password_title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/rc_margin_size_16"
        android:paddingEnd="@dimen/rc_margin_size_16">

        <!-- 手机号 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/rc_margin_size_16"
            android:text="@string/seal_minor_mode_phone_number"
            android:textColor="?attr/rc_text_primary_color"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <!-- 国家区号 -->
            <LinearLayout
                android:id="@+id/ll_country_code"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/rc_lively_common_background_radius_8"
                android:gravity="center"
                android:minWidth="80dp"
                android:paddingStart="@dimen/rc_margin_size_12"
                android:paddingEnd="@dimen/rc_margin_size_12">

                <TextView
                    android:id="@+id/tv_country_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+86"
                    android:textColor="?attr/rc_text_primary_color"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- 手机号输入框 -->
            <EditText
                android:id="@+id/et_phone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/rc_lively_common_background_radius_8"
                android:inputType="phone"
                android:paddingStart="@dimen/rc_margin_size_12"
                android:paddingEnd="@dimen/rc_margin_size_12"
                android:textColor="?attr/rc_text_primary_color"
                android:textColorHint="?attr/rc_text_secondary_color"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 图片验证码 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/rc_margin_size_16"
            android:text="@string/seal_minor_mode_image_code"
            android:textColor="?attr/rc_text_primary_color"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_image_code"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/rc_lively_common_background_radius_8"
                android:inputType="text"
                android:paddingStart="@dimen/rc_margin_size_12"
                android:paddingEnd="@dimen/rc_margin_size_12"
                android:textColor="?attr/rc_text_primary_color"
                android:textColorHint="?attr/rc_text_secondary_color"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/iv_image_code"
                android:layout_width="120dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:background="@drawable/rc_lively_common_background_radius_8"
                android:scaleType="fitXY"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- 短信验证码 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/rc_margin_size_16"
            android:text="@string/seal_minor_mode_sms_code"
            android:textColor="?attr/rc_text_primary_color"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/rc_lively_common_background_radius_8"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/rc_margin_size_12"
            android:paddingEnd="@dimen/rc_margin_size_12">

            <EditText
                android:id="@+id/et_sms_code"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:inputType="number"
                android:maxLength="6"
                android:textColor="?attr/rc_text_primary_color"
                android:textColorHint="?attr/rc_text_secondary_color"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_get_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:text="@string/seal_minor_mode_get_sms_code"
                android:textColor="?attr/rc_primary_color"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- 重置密码按钮 -->
    <Button
        android:id="@+id/btn_reset"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="@dimen/rc_margin_size_16"
        android:layout_marginEnd="@dimen/rc_margin_size_16"
        android:layout_marginBottom="30dp"
        android:background="@drawable/seal_login_button_selector"
        android:stateListAnimator="@null"
        android:text="@string/seal_minor_mode_reset_password"
        android:textColor="@color/rc_white_color"
        android:textSize="17sp" />

</LinearLayout>

