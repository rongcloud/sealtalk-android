<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:descendantFocusability="blocksDescendants">

    <!-- 字母分组头 -->
    <LinearLayout
        android:id="@+id/ll_firstchar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_char"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/rc_text_primary_color"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="A" />
    </LinearLayout>

    <!-- 国家信息容器 -->
    <RelativeLayout
        android:id="@+id/rl_country_container"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_below="@id/ll_firstchar"
        android:background="?attr/rc_bottom_dialog_background_color"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/tv_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:textColor="?attr/rc_text_primary_color"
            android:textSize="17sp"
            tools:text="+86" />

        <TextView
            android:id="@+id/tv_country"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_toEndOf="@id/tv_code"
            android:textColor="?attr/rc_text_primary_color"
            android:textSize="17sp"
            tools:text="中国" />

        <!-- 分隔线 -->
        <View
            android:id="@+id/v_divider"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_alignParentBottom="true"
            android:background="?attr/rc_line_background_color" />
    </RelativeLayout>

</RelativeLayout>

