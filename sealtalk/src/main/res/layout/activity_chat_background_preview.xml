<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/rc_auxiliary_background_1_color">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 标题栏 -->
        <io.rong.imkit.usermanage.component.HeadComponent
            android:id="@+id/head_component"
            android:layout_width="match_parent"
            android:layout_height="@dimen/rc_title_bar_height"
            app:head_left_text_drawable="?attr/rc_navigation_bar_btn_back_img"
            app:head_title_text="@string/seal_select_chat_bg_preset" />

        <!-- 图片预览区域 -->
        <cn.rongcloud.im.utils.AsyncImageView
            android:id="@+id/iv_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

    </LinearLayout>

    <!-- 用于发送图片时的原图选择和发送按钮 (FROM_RECENT_PICTURE) -->
    <RelativeLayout
        android:id="@+id/rl_send_actions"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom"
        android:background="?attr/rc_mask_color"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/ll_select_origin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cb_select_origin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@null"
                android:button="@drawable/seal_checkbox_selector"
                android:clickable="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/seal_select_chat_bg_origin"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/btn_send"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/seal_select_chat_bg_send"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

    </RelativeLayout>

</FrameLayout>