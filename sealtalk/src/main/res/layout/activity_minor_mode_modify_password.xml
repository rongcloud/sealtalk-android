<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/rc_auxiliary_background_1_color"
    android:orientation="vertical">

    <io.rong.imkit.usermanage.component.HeadComponent
        android:id="@+id/head_component"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:head_title_text="@string/seal_minor_mode_modify_password_title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/rc_margin_size_16"
        android:paddingEnd="@dimen/rc_margin_size_16">

        <!-- 原密码 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/rc_margin_size_16"
            android:text="@string/seal_minor_mode_old_password"
            android:textColor="?attr/rc_text_primary_color"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/rc_lively_common_background_radius_8"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/rc_margin_size_12"
            android:paddingEnd="@dimen/rc_margin_size_12">

            <EditText
                android:id="@+id/et_old_password"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/seal_minor_mode_password_hint"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:textColor="?attr/rc_text_primary_color"
                android:textColorHint="?attr/rc_text_secondary_color"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/iv_toggle_old_password"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="?attr/rc_minor_eye_close"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- 设置新密码 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/rc_margin_size_16"
            android:text="@string/seal_minor_mode_new_password"
            android:textColor="?attr/rc_text_primary_color"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/rc_lively_common_background_radius_8"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/rc_margin_size_12"
            android:paddingEnd="@dimen/rc_margin_size_12">

            <EditText
                android:id="@+id/et_new_password"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/seal_minor_mode_password_hint"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:textColor="?attr/rc_text_primary_color"
                android:textColorHint="?attr/rc_text_secondary_color"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/iv_toggle_new_password"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="?attr/rc_minor_eye_close"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- 确认新密码 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/rc_margin_size_16"
            android:text="@string/seal_minor_mode_confirm_new_password"
            android:textColor="?attr/rc_text_primary_color"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/rc_lively_common_background_radius_8"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/rc_margin_size_12"
            android:paddingEnd="@dimen/rc_margin_size_12">

            <EditText
                android:id="@+id/et_confirm_new_password"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/seal_minor_mode_password_hint"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:textColor="?attr/rc_text_primary_color"
                android:textColorHint="?attr/rc_text_secondary_color"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/iv_toggle_confirm_new_password"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="?attr/rc_minor_eye_close"
                android:contentDescription="@null" />
        </LinearLayout>

    </LinearLayout>

    <!-- 确定按钮 -->
    <Button
        android:id="@+id/btn_confirm"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="@dimen/rc_margin_size_16"
        android:layout_marginEnd="@dimen/rc_margin_size_16"
        android:layout_marginBottom="30dp"
        android:background="@drawable/seal_login_button_selector"
        android:stateListAnimator="@null"
        android:text="@string/common_confirm"
        android:textColor="@color/rc_white_color"
        android:textSize="17sp" />

</LinearLayout>

