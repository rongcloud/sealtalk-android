<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/seal_title_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/rc_margin_size_12"
        android:paddingEnd="@dimen/rc_margin_size_12">

        <cn.rongcloud.im.ui.widget.SelectableRoundedImageView
            android:id="@+id/iv_portrait"
            android:layout_width="@dimen/seal_search_item_portrait_height"
            android:layout_height="@dimen/seal_search_item_portrait_width"
            android:scaleType="centerCrop"
            android:src="?attr/rc_conversation_list_cell_portrait_msg_img"
            app:sriv_oval="true"
            app:sriv_left_bottom_corner_radius="@dimen/seal_search_item_portrait_radius"
            app:sriv_left_top_corner_radius="@dimen/seal_search_item_portrait_radius"
            app:sriv_right_bottom_corner_radius="@dimen/seal_search_item_portrait_radius"
            app:sriv_right_top_corner_radius="@dimen/seal_search_item_portrait_radius" />

        <TextView
            android:id="@+id/tv_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/seal_search_item_portrait_margin_right"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/rc_text_primary_color"
            android:textSize="@dimen/seal_search_item_name_text_size" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="68dp"
        android:layout_marginEnd="@dimen/rc_margin_size_12"
        android:background="?attr/rc_line_background_color" />
</LinearLayout>
