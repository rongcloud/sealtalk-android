<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/rc_auxiliary_background_1_color"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/rc_margin_size_16"
        android:paddingEnd="@dimen/rc_margin_size_16">

        <!-- 从手机相册选择 -->
        <cn.rongcloud.im.ui.view.SettingItemView
            android:id="@+id/siv_select_from_album"
            android:layout_width="match_parent"
            android:layout_height="@dimen/rc_title_bar_height"
            app:item_content="@string/seal_select_chat_bg_album"
            app:item_divider="true"
            app:item_right_image="?attr/rc_right_arrow_icon_img" />

        <!-- 预置图片 -->
        <cn.rongcloud.im.ui.view.SettingItemView
            android:id="@+id/siv_preset_backgrounds"
            android:layout_width="match_parent"
            android:layout_height="@dimen/rc_title_bar_height"
            app:item_content="@string/seal_select_chat_bg_preset"
            app:item_right_image="?attr/rc_right_arrow_icon_img" />
    </LinearLayout>

</LinearLayout>