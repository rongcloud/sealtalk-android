<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/rc_page_background"
    android:orientation="vertical">

    <!-- 自定义标题栏 -->
    <RelativeLayout
        android:id="@+id/custom_title_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- 标题 -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:textColor="?attr/rc_text_primary_color"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- 二维码按钮 -->
        <ImageView
            android:id="@+id/iv_qrcode"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:clickable="true"
            android:focusable="true"
            android:padding="5dp"
            android:src="?attr/rc_mine_qrcode"
            android:contentDescription="@string/seal_main_mine_qrcode" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/rc_margin_size_16"
            android:paddingEnd="@dimen/rc_margin_size_16"
            android:paddingBottom="30dp">

            <!-- 用户信息区域 -->
            <RelativeLayout
                android:id="@+id/rl_user_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="88dp"
                android:paddingStart="@dimen/rc_margin_size_16"
                android:paddingTop="@dimen/rc_margin_size_16"
                android:paddingEnd="@dimen/rc_margin_size_16"
                android:paddingBottom="@dimen/rc_margin_size_16">

                <!-- 用户头像 -->
                <cn.rongcloud.im.ui.widget.SelectableRoundedImageView
                    android:id="@+id/iv_user_portrait"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:scaleType="centerCrop"
                    app:sriv_border_width="1dp"
                    app:sriv_border_color="?attr/rc_user_portrait_border_color"
                    android:src="@drawable/rc_default_portrait"
                    app:sriv_oval="true" />

                <!-- 用户信息文本区域 -->
                <LinearLayout
                    android:id="@+id/ll_user_info_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/rc_margin_size_12"
                    android:layout_marginEnd="8dp"
                    android:layout_toEndOf="@id/iv_user_portrait"
                    android:orientation="vertical">

                    <!-- 用户名 -->
                    <TextView
                        android:id="@+id/tv_user_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="用户名"
                        android:textColor="?attr/rc_text_primary_color"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- 用户账号 -->
                    <TextView
                        android:id="@+id/tv_user_account"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/seal_main_me_app_account_label"
                        android:textColor="?attr/rc_text_primary_color"
                        android:textSize="14sp" />
                </LinearLayout>

            </RelativeLayout>

            <!-- 账号设置 -->
            <io.rong.imkit.widget.SettingItemView
                android:id="@+id/siv_account_setting"
                android:layout_width="match_parent"
                android:layout_height="@dimen/rc_title_bar_height"
                app:item_content="@string/seal_main_mine_set_account"
                app:item_divider="true"
                app:item_image="?attr/rc_mine_setting"
                app:item_right_image="?attr/rc_right_arrow_icon_img"
                app:item_right_image_auto_mirrored="true"
                app:item_value_text_size="17sp" />

            <!-- 多语言 -->
            <io.rong.imkit.widget.SettingItemView
                android:id="@+id/siv_language"
                android:layout_width="match_parent"
                android:layout_height="@dimen/rc_title_bar_height"
                app:item_content="@string/seal_main_mine_setting_language"
                app:item_divider="true"
                app:item_image="?attr/rc_mine_language"
                app:item_right_image="?attr/rc_right_arrow_icon_img"
                app:item_right_image_auto_mirrored="true"
                app:item_value="@string/lang_chs"
                app:item_value_text_size="17sp" />


            <!-- 翻译设置 -->
            <io.rong.imkit.widget.SettingItemView
                android:id="@+id/siv_translation"
                android:layout_width="match_parent"
                android:layout_height="@dimen/rc_title_bar_height"
                app:item_content="@string/seal_main_mine_setting_translation"
                app:item_divider="true"
                app:item_image="?attr/rc_mine_translate"
                app:item_right_image="?attr/rc_right_arrow_icon_img"
                app:item_right_image_auto_mirrored="true"
                app:item_value_text_size="17sp" />

            <!-- 切换主题 -->
            <io.rong.imkit.widget.SettingItemView
                android:id="@+id/siv_theme_setting"
                android:layout_width="match_parent"
                android:layout_height="@dimen/rc_title_bar_height"
                app:item_content="@string/seal_main_mine_theme_setting"
                app:item_divider="true"
                app:item_image="?attr/rc_mine_theme"
                app:item_right_image="?attr/rc_right_arrow_icon_img"
                app:item_right_image_auto_mirrored="true"
                app:item_value_text_size="17sp" />

            <!-- 意见反馈 -->
            <io.rong.imkit.widget.SettingItemView
                android:id="@+id/siv_feedback"
                android:layout_width="match_parent"
                android:layout_height="@dimen/rc_title_bar_height"
                app:item_content="@string/seal_main_mine_feedback"
                app:item_divider="true"
                app:item_image="?attr/rc_mine_feedback"
                app:item_right_image="?attr/rc_right_arrow_icon_img"
                app:item_right_image_auto_mirrored="true"
                app:item_value_text_size="17sp" />

            <!-- 未成年人模式 -->
            <io.rong.imkit.widget.SettingItemView
                android:id="@+id/siv_minor_mode"
                android:layout_width="match_parent"
                android:layout_height="@dimen/rc_title_bar_height"
                app:item_content="@string/seal_minor_mode_title"
                app:item_divider="true"
                app:item_image="?attr/rc_mine_minor"
                app:item_right_image="?attr/rc_right_arrow_icon_img"
                app:item_right_image_auto_mirrored="true"
                app:item_value_text_size="17sp" />

            <!-- 隐私政策 -->
            <io.rong.imkit.widget.SettingItemView
                android:id="@+id/siv_privacy"
                android:layout_width="match_parent"
                android:layout_height="@dimen/rc_title_bar_height"
                app:item_content="@string/seal_talk_privacy_policy_title"
                app:item_divider="true"
                app:item_image="?attr/rc_mine_privacy"
                app:item_right_image="?attr/rc_right_arrow_icon_img"
                app:item_right_image_auto_mirrored="true"
                app:item_value_text_size="17sp" />

            <!-- 关于融云 IM -->
            <io.rong.imkit.widget.SettingItemView
                android:id="@+id/siv_about"
                android:layout_width="match_parent"
                android:layout_height="@dimen/rc_title_bar_height"
                app:item_content="@string/seal_main_mine_about"
                app:item_divider="false"
                app:item_image="?attr/rc_mine_about"
                app:item_right_image="?attr/rc_right_arrow_icon_img"
                app:item_right_image_auto_mirrored="true"
                app:item_tag_image_height="@dimen/seal_mine_setting_item_tag_height"
                app:item_tag_image_width="@dimen/seal_mine_setting_item_tag_width"
                app:item_value_text_size="17sp" />

            <!-- 退出登录按钮 -->
            <Button
                android:id="@+id/btn_logout"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="40dp"
                android:background="@drawable/rc_lively_common_background_radius_8"
                android:stateListAnimator="@null"
                android:text="@string/seal_mine_set_account_logout"
                android:textColor="?attr/rc_hint_color"
                android:textSize="17sp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
