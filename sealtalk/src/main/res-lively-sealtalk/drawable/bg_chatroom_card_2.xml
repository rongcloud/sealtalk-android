<?xml version="1.0" encoding="utf-8"?>
<!-- 暖阳小窝卡片背景 - 支持浅色/暗色模式 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="?attr/chatroom_card_2_start_color"
        android:endColor="?attr/chatroom_card_2_end_color"
        android:type="linear" />
    <corners android:radius="13dp" />
    <stroke
        android:width="2dp"
        android:color="?attr/rc_common_background_color" />

</shape>
